"""
    Returns the number of seconds required for the virus to spread to everyone.

    Parameters:
    n (int): The number of people standing in a circle.
    p (int): The position of the initially infected person.

    Returns:
    int: The minimum number of seconds required for the virus to spread to everyone.
    """
def time_to_infect_everyone(n: int, p: int) -> int {
    return (n - 1);
}

