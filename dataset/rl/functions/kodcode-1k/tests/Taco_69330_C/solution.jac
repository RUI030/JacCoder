"""
    Returns the maximum possible absolute difference between the number of coins Ben and Chris receive
    when Alex distributes 'n' coins according to the rules.

    Parameters:
        n (int): The number of coins Alex has (2 ≤ n ≤ 10^9).

    Returns:
        int: The maximum possible absolute difference.
    """
def max_difference(n: int) -> int {
    max_diff = n - 2;
    return max_diff;
}

