"""
    Verifies if the entered captcha matches the generated captcha.

    Parameters:
    generated_captcha (str): The captcha code generated by the system.
    entered_captcha (str): The captcha code entered by the user.

    Returns:
    bool: True if the entered captcha matches the generated captcha, otherwise False.
    """
def verify_captcha(generated_captcha: str, entered_captcha: str) -> bool {
    return (generated_captcha == entered_captcha);
}

